classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet) None
        +get_pet(name) Pet
        +remove_pet(name) None
        +get_all_tasks() list~Task~
        +save_to_json(path) None
        +load_from_json(path)$ Owner
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
        +task_count() int
        +to_dict() dict
        +from_dict(data)$ Pet
    }

    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +date due_date
        +bool completed
        +str pet_name
        +end_minutes() int
        +mark_complete() None
        +next_occurrence() Task
        +to_dict() dict
        +from_dict(data)$ Task
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() list~Task~
        +todays_schedule(day) list~Task~
        +sort_by_time(tasks) list~Task~
        +sort_by_priority(tasks) list~Task~
        +filter_tasks(tasks, pet_name, completed) list~Task~
        +mark_task_complete(task) Task
        +detect_conflicts(tasks) list~str~
        +find_next_available_slot(duration, day, day_start, day_end) str
        +build_daily_plan(day) tuple
        +explain_plan(day) list~str~
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" *-- "*" Task : has
    Task ..> Task : next_occurrence() creates
    Scheduler --> Owner : reads pets and tasks from
    Scheduler ..> Task : sorts / filters / completes
